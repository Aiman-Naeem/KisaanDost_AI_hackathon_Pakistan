# KisaanDost API Configuration Example
# Copy this file to .env and fill in your backend's actual address.

# Backend API base URL (without trailing slash)
# Local development: http://localhost:3000
# ngrok tunnel: https://abc123.ngrok.io (example)
# Local IP: http://192.168.1.100:3000 (example)
API_BASE_URL=http://localhost:3000
